[Unit]
Description=RAE digital platform Next.js staging (loopback on the host, CMS network only)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --name rae-digital-next \
  --network rae-cms-net \
  -p 127.0.0.1:3417:3417 \
  --env-file %h/rae/rae-cms-secrets/site.env \
  -e HOSTNAME=0.0.0.0 \
  -e RAE_CMS_DATA_DIR=/data \
  -v %h/rae/current:/app \
  -v %h/rae/rae-cms-data:/data \
  -w /app \
  node:22-bookworm-slim \
  node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3417
ExecStop=/usr/bin/docker stop rae-digital-next
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
