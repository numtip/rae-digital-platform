# Configuration names only — no values, no secrets. The real file lives outside the repo
# (0600) next to the runtime host; this repository never stores credentials.
RAE_CMS_DB_HOST=127.0.0.1
RAE_CMS_DB_PORT=3306
RAE_CMS_DB_NAME=rae_cms
RAE_CMS_DB_USER=rae_cms_app
RAE_CMS_DB_PASSWORD=            # from the protected file, never committed
RAE_CMS_API_PORT=3317
RAE_CMS_API_ORIGIN=             # http://127.0.0.1:<port> only; never a public origin
