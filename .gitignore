# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — never commit
.env
.env.*
!.env.example
!.env.staging.example
.staging-local/
*.pem
*.key
*agent-core.token
*credentials*.json
.credentials/

# Runtime / build
node_modules/
/.next/
/out/
# Local CMS media when RAE_CMS_MEDIA_DIR is unset (tests use their own temp dir)
.cms-media/
# Runtime state the CMS cannot rebuild: the ids the publish hook reported withdrawn. Never
# committed — a deployment keeps it on a volume so a tombstone survives a restart.
.cms-data/
# Static preview of published CMS articles (generated, never deployed)
out-cms-preview/
# Site data for CMS-published news, written by `scripts/cms-sync.mjs` and committed on purpose:
# GitHub Pages serves static files, so the article and its images have to be in the tree.
/build/
/dist/
/coverage/
/.vercel/
.astro/
__pycache__/
*.py[cod]
.venv/
venv/
*.log

# TypeScript / Next generated — never hand-edit
next-env.d.ts
*.tsbuildinfo
