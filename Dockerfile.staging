# Static VPS staging image — serves Next.js export (out/) via nginx only.
# Build context must include a fresh `out/` directory (see scripts/staging/deploy.sh).

FROM nginx:1.27-alpine

RUN rm -f /etc/nginx/conf.d/default.conf

COPY deploy/staging/nginx/default.conf /etc/nginx/conf.d/default.conf

# Immutable artefact for this release (populated before docker build).
COPY out /usr/share/nginx/html

RUN test -f /usr/share/nginx/html/th/index.html \
    && test -f /usr/share/nginx/html/en/index.html \
    && nginx -t

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
