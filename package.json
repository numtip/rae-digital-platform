{
  "name": "rae-digital-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:export": "NEXT_PAGES_PREVIEW=1 next build",
    "check:export": "node scripts/check-export.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "qa": "npm test && npm run lint && npm run typecheck && npm run build && npm run build:export && npm run check:export && npm run check:contrast && npm run check:a11y",
    "check:a11y": "node scripts/check-a11y.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.82.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "shadcn": "^4.23.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.8.3"
  },
