{
  "name": "rae-digital-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:export": "NEXT_PAGES_PREVIEW=1 next build",
    "check:export": "node scripts/check-export.mjs",
    "qa": "npm test && npm run lint && npm run typecheck && npm run build && npm run build:export && npm run check:export"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3"
  },
  "license": "Apache-2.0"
}
