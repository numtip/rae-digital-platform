# Non-secret staging build/runtime settings (copy to .env.staging locally; never commit secrets).
# Used by scripts/staging/deploy.sh on the VPS after owner approval.

# Git commit for this release (required at deploy time).
RAE_STAGING_RELEASE=

# Next.js static export — must match host nginx path prefix (see deploy/staging/host-nginx.reference.conf).
NEXT_PAGES_PREVIEW=1
NEXT_PREVIEW_BASE_PATH=/rae-digital-staging

# Public canonical URL for metadata (no credentials). Owner sets real vhost when known.
NEXT_PUBLIC_SITE_URL=https://raeservice.mju.ac.th/rae-digital-staging

# Optional override for check-export after VPS-oriented build.
BASE_PATH=/rae-digital-staging

# Compose project directory on VPS (created by owner, not world-writable).
RAE_STAGING_ROOT=/opt/rae-digital-staging

# Docker Compose file (path relative to repo checkout on VPS).
RAE_STAGING_COMPOSE=docker-compose.staging.yml
